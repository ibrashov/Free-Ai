{
  "name": "anuar-free-ai-console",
  "displayName": "Free AI Console",
  "description": "Separate VS Code panel for the local free-claude-code gateway.",
  "version": "0.2.0",
  "publisher": "anuar-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*",
    "onView:freeAiConsole.chatView",
    "onCommand:freeAiConsole.openChat",
    "onCommand:freeAiConsole.refreshFreeModels",
    "onCommand:freeAiConsole.testProviders",
    "onCommand:freeAiConsole.openProviderStatus"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "freeAiConsole.openChat",
        "title": "Free AI: Open Chat"
      },
      {
        "command": "freeAiConsole.refreshFreeModels",
        "title": "Free AI: Refresh Free Models"
      },
      {
        "command": "freeAiConsole.testProviders",
        "title": "Free AI: Test Providers"
      },
      {
        "command": "freeAiConsole.openProviderStatus",
        "title": "Free AI: Open Provider Status"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "freeAiConsole",
          "title": "Free AI",
          "icon": "media/free-ai.svg"
        }
      ]
    },
    "views": {
      "freeAiConsole": [
        {
          "id": "freeAiConsole.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Free AI Console",
      "properties": {
        "freeAiConsole.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8082",
          "description": "free-claude-code gateway URL."
        },
        "freeAiConsole.authToken": {
          "type": "string",
          "default": "freecc",
          "description": "Gateway auth token."
        },
        "freeAiConsole.defaultProvider": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "opencode",
            "cerebras",
            "gemini",
            "gemini-fast",
            "groq",
            "openrouter",
            "gemma",
            "ollama"
          ],
          "description": "Default provider for Free AI Console."
        },
        "freeAiConsole.freePolicy": {
          "type": "string",
          "default": "no-card",
          "enum": [
            "no-card",
            "free-tier"
          ],
          "description": "Free usage policy for auto routing."
        },
        "freeAiConsole.autoMode": {
          "type": "string",
          "default": "balanced",
          "enum": [
            "balanced",
            "compare",
            "survival"
          ],
          "description": "Auto routing mode. Balanced uses one cheap provider plus fallback; compare asks several providers; survival uses local Ollama."
        },
        "freeAiConsole.openCodeCommand": {
          "type": "string",
          "default": "opencode",
          "description": "OpenCode command used by the OpenCode Agent provider."
        },
        "freeAiConsole.openCodeModel": {
          "type": "string",
          "default": "anthropic/claude-sonnet-4-0",
          "description": "OpenCode model in provider/model format."
        },
        "freeAiConsole.openCodeFallbackToOllama": {
          "type": "boolean",
          "default": true,
          "description": "Retry OpenCode with the local Ollama model when the gateway/cloud provider is rate limited."
        },
        "freeAiConsole.providerCooldownMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Minutes to avoid a provider after rate limit or provider failure."
        },
        "freeAiConsole.localCoderModel": {
          "type": "string",
          "default": "ollama/qwen2.5-coder:3b",
          "description": "Local Ollama model used for survival mode and OpenCode fallback."
        }
      }
    }
  }
}
